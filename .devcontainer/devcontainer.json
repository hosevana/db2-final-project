{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash .devcontainer/setup-vcpkg.sh",
  "remoteEnv": {
    "VCPKG_ROOT": "${containerEnv:HOME}/vcpkg",
    "PATH": "${containerEnv:HOME}/vcpkg:${containerEnv:PATH}"
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true",
      "installGradle": "false"
    }
  }
}
