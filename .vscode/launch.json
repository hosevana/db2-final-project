            "preLaunchTask": "build",
            "program": "${workspaceFolder}/cs_CRUD/bin/Debug/net10.0/cs_CRUD.dll",
            "args": [],
            "cwd": "${workspaceFolder}/cs_CRUD",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
